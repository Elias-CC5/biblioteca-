@model Biblioteca.Web.Models.Libro

<h2>@ViewData["Title"]</h2>
<h4 class="text-danger">¿Está seguro de que desea eliminar este libro?</h4>
<hr />

<dl class="row">
    <dt class="col-sm-3">Título</dt>
    <dd class="col-sm-9">@Model.Titulo</dd>

    <dt class="col-sm-3">ISBN</dt>
    <dd class="col-sm-9">@Model.ISBN</dd>

    <dt class="col-sm-3">Autor</dt>
    <dd class="col-sm-9">@Model.AutorNombre</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="LibroId" />
    <button type="submit" class="btn btn-danger">Confirmar Eliminación</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>