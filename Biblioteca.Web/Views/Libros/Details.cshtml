@model Biblioteca.Web.Models.Libro

<h2>@ViewData["Title"]</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.LibroId</dd>

    <dt class="col-sm-3">Título</dt>
    <dd class="col-sm-9">@Model.Titulo</dd>

    <dt class="col-sm-3">ISBN</dt>
    <dd class="col-sm-9">@Model.ISBN</dd>

    <dt class="col-sm-3">Autor</dt>
    <dd class="col-sm-9">@Model.AutorNombre</dd>

    <dt class="col-sm-3">Ejemplares</dt>
    <dd class="col-sm-9">@Model.Ejemplares</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.LibroId" class="btn btn-warning">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver al listado</a>